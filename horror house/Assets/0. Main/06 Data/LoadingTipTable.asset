  m_Script: {fileID: 11500000, guid: bc3d90af10b6b9241a0d250089e591c3, type: 3}
  m_Name: LoadingTipTable
  m_EditorClassIdentifier: Assembly-CSharp::LoadingTipTable
  tips:
  - "W A S D \uB85C \uC774\uB3D9\uD558\uACE0, \uB9C8\uC6B0\uC2A4\uB85C \uC8FC\uBCC0\uC744
    \uB458\uB7EC\uBD05\uB2C8\uB2E4."
  - "Shift \uB97C \uB204\uB978 \uCC44 \uC774\uB3D9\uD558\uBA74 \uB2EC\uB9B4 \uC218
    \uC788\uC2B5\uB2C8\uB2E4."
  - "Space \uB97C \uB204\uB974\uBA74 \uC810\uD504\uD569\uB2C8\uB2E4."
  - "Esc \uB97C \uB204\uB974\uBA74 \uC77C\uC2DC\uC815\uC9C0 \uBA54\uB274\uAC00 \uC5F4\uB9BD\uB2C8\uB2E4."
  - "Tab\uC73C\uB85C \uC624\uB298 \uBC1B\uC740 \uADFC\uBB34\uC218\uCE59\uACFC \uBA54\uC2DC\uC9C0\uB97C
    \uB2E4\uC2DC \uD655\uC778\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - "E\uB85C \uC870\uC791 \uAC00\uB2A5\uD55C \uBB38\uC744 \uC5F4\uAC70\uB098 \uB2EB\uC744
    \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - "\uADFC\uBB34\uC218\uCE59\uC740 \uB0A0\uB9C8\uB2E4 \uB2EC\uB77C\uC9D1\uB2C8\uB2E4.
    \uC624\uB298 \uBC1B\uC740 \uB0B4\uC6A9\uB9CC \uD310\uC815\uB429\uB2C8\uB2E4."
  - "\uC624\uB798 \uBC14\uB77C\uBCF4\uAC70\uB098 \uAC00\uAE4C\uC774 \uB2E4\uAC00\uAC00\uB294
    \uD589\uB3D9\uB3C4 \uD310\uC815\uB420 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - "\uADFC\uBB34 \uC77C\uC9C0\uC758 \uBE68\uAC04 \uC904\uC740 \uC704\uBC18\uD55C
    \uC218\uCE59\uC744 \uD45C\uC2DC\uD569\uB2C8\uB2E4."
  - "\uBA54\uC2DC\uC9C0\uB97C \uB530\uB974\uAE30 \uC804\uC5D0 \uC624\uB298\uC758
    \uADFC\uBB34\uC218\uCE59\uACFC \uCDA9\uB3CC\uD558\uB294\uC9C0 \uD655\uC778\uD558\uC2ED\uC2DC\uC624."
  - "\uADFC\uBB34\uC218\uCE59\uC744 \uACC4\uC18D \uB530\uB97C\uC218\uB85D \uD310\uB2E8\uD574\uC57C
    \uD560 \uBA54\uC2DC\uC9C0\uAC00 \uB298\uC5B4\uB0A0 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - "\uC870\uBA85\uC758 \uC0C9\uC740 \uD604\uC7AC \uC870\uB3C4 \uC704\uD5D8\uC744
    \uB4DC\uB7EC\uB0C5\uB2C8\uB2E4. \uCF1C\uC9C4 \uC870\uBA85 \uC218\uB97C \uC140
    \uD544\uC694\uB294 \uC5C6\uC2B5\uB2C8\uB2E4."
  - "\uADFC\uBB34\uB294 04:00\uC5D0 \uC885\uB8CC\uB429\uB2C8\uB2E4. \uC885\uB8CC
    \uC2DC\uC810\uAE4C\uC9C0 \uBC1C\uC0DD\uD55C \uD310\uC815\uC740 \uC801\uC6A9\uB429\uB2C8\uB2E4."
  unlockedTips:
  - "\uB3C4\uB9DD\uAC14\uB2E4\uB358 \uACBD\uBE44\uC6D0\uC758 \uD1F4\uC2E4 \uAE30\uB85D\uC740
    \uD655\uC778\uB418\uC9C0 \uC54A\uC558\uB2E4."
  - "\uC774\uC804 \uACBD\uBE44\uC6D0\uC774 \uB9C8\uC9C0\uB9C9\uC73C\uB85C \uC751\uB2F5\uD55C
    \uC2DC\uAC01\uC740 03:58\uC774\uC5C8\uB2E4."
  - "\uACFC\uD559\uC2E4\uC5D0\uC11C \uD655\uC778\uD55C \uBAA8\uD615\uC740 \uD559\uAD50\uC758
    \uC790\uC0B0 \uBAA9\uB85D\uC5D0 \uC5C6\uC5C8\uB2E4."
  - "\uC774\uC804 \uADFC\uBB34\uC790\uC758 \uAE30\uB85D\uC740 \uB450 \uBC88\uC9F8
    \uAD00\uCE21\uC5D0\uC11C \uBA48\uCDB0 \uC788\uC5C8\uB2E4."
  backgrounds: []
