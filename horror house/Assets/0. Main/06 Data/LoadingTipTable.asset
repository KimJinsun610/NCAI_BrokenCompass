  tipCsv: {fileID: 4900000, guid: 5a9ef5a487dda25429939ad0e6463399, type: 3}
  tips:
  - "Tab \uD0A4\uB85C \uD0DC\uBE14\uB9BF\uC744 \uC62C\uB9AC\uACE0 \uB0B4\uB9B4 \uC218
    \uC788\uB2E4."
  - "\uD0DC\uBE14\uB9BF\uC744 \uC62C\uB9B0 \uCC44 \uC2A4\uD06C\uB864\uD558\uAC70\uB098
    Q \uD0A4\uB97C \uB204\uB974\uBA74 \uADFC\uBB34\uC218\uCE59\uACFC \uBB38\uC790\uD568
    \uD0ED\uC744 \uC804\uD658\uD560 \uC218 \uC788\uB2E4."
  - "F \uD0A4\uB85C \uC190\uC804\uB4F1\uC744 \uCF1C\uACE0 \uB04C \uC218 \uC788\uB2E4."
  - "\uADFC\uBB34\uC218\uCE59\uC740 \uB9E4\uC77C \uBC14\uB010\uB2E4. \uCD9C\uADFC\uD558\uBA74
    \uC218\uCE59\uC11C\uBD80\uD130 \uC77D\uC5B4 \uB450\uC790."
  - "\uACBD\uBE44\uC2E4\uC5D0 \uC228\uC5B4 \uC788\uB294\uB2E4\uACE0 \uC548\uC804\uD55C
    \uAC83\uC740 \uC544\uB2C8\uB2E4."
  - "\uD0DC\uBE14\uB9BF\uC774 \uC6B8\uB9AC\uBA74 \uBB38\uC790\uD568\uC744 \uD655\uC778\uD558\uC790.
    \uC5C5\uBB34 \uD638\uCD9C\uC774 \uC654\uC744 \uC218 \uC788\uB2E4."
  - "\uC5B4\uC81C \uC815\uC0C1\uC774\uB358 \uAC83\uC774 \uC624\uB298\uB3C4 \uC815\uC0C1\uC774\uB77C\uB294
    \uBCF4\uC7A5\uC740 \uC5C6\uB2E4."
  - "\uC218\uCE59\uC740 \uB05D\uAE4C\uC9C0 \uC77D\uC790. \uB9C8\uC9C0\uB9C9 \uD55C
    \uC904\uC774 \uAC00\uC7A5 \uC911\uC694\uD560 \uC218 \uC788\uB2E4."
  - "\uBB34\uC5B8\uAC00 \uC774\uC0C1\uD558\uB2E4\uBA74, \uBA3C\uC800 \uC218\uCE59\uC744
    \uB5A0\uC62C\uB9AC\uC790."
  - "\uB4E4\uB9AC\uB294 \uAC83\uC744 \uBAA8\uB450 \uBBFF\uC9C0\uB294 \uB9D0\uC790."
  - "\uC190\uC804\uB4F1\uC774 \uC5B8\uC81C\uB098 \uB2F9\uC2E0 \uD3B8\uC778 \uAC83\uC740
    \uC544\uB2C8\uB2E4."
  - "\uD655\uC2E4\uD558\uC9C0 \uC54A\uB2E4\uBA74 \uD55C \uBC88 \uB354 \uBCF4\uACE0
    \uBCF4\uACE0\uD558\uC790."
  unlockedTips:
  - "\uB3C4\uB9DD\uAC14\uB2E4\uB358 \uACBD\uBE44\uC6D0\uC758 \uD1F4\uC2E4 \uAE30\uB85D\uC740
    \uD655\uC778\uB418\uC9C0 \uC54A\uC558\uB2E4."
  - "\uC774\uC804 \uACBD\uBE44\uC6D0\uC774 \uB9C8\uC9C0\uB9C9\uC73C\uB85C \uC751\uB2F5\uD55C
    \uC2DC\uAC01\uC740 03:58\uC774\uC5C8\uB2E4."
  - "\uACFC\uD559\uC2E4\uC5D0\uC11C \uD655\uC778\uD55C \uBAA8\uD615\uC740 \uD559\uAD50\uC758
    \uC790\uC0B0 \uBAA9\uB85D\uC5D0 \uC5C6\uC5C8\uB2E4."
  - "\uC774\uC804 \uADFC\uBB34\uC790\uC758 \uAE30\uB85D\uC740 \uB450 \uBC88\uC9F8
    \uAD00\uCE21\uC5D0\uC11C \uBA48\uCDB0 \uC788\uC5C8\uB2E4."
